# P2 generated data must round-trip through Windows Git byte-for-byte.
mem/game_p2_static.mem text eol=lf
rtl/config/game_p2_*.vh text eol=lf
scores/p2/*.csv text eol=lf
scores/p2/*.json text eol=lf
scores/p2/*.bin binary

/rtl/config/game_p2_bsram_init.vh text eol=lf

# Preserve the exact bytes of fixed KS release archives and audit records.
/build/karplus_strong/verification.json -text
/build/ks_fifth/** -text
/build/lcd_rotate_ks/** -text
/build/releases/touch_game/ks_*.zip binary

# Fixed successful release receipts keep their original build-time bytes.
/build/dual_score_transport/** -text
/build/input_rotation_imu/** -text
/build/song_slots_123/** -text
/build/companion_ui/** -text
/build/releases/android/**/verification.json -text
/build/releases/windows/**/manifest.json -text
/build/exports/*.zip binary
