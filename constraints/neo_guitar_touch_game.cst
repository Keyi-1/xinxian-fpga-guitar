# NEO Dock 31005: MS5351M CLK2 configured for 12.288 MHz
IO_LOC  "audio_clk_12m288" V13;
IO_PORT "audio_clk_12m288" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

# NEO Dock user keys, all active low, Bank 9 at 1.5 V. No reset key.
IO_LOC  "USER_BUTTON1_n" AA13;
IO_PORT "USER_BUTTON1_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;

IO_LOC  "USER_BUTTON2_n" AB13;
IO_PORT "USER_BUTTON2_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;
IO_LOC  "USER_BUTTON3_n" Y12;
IO_PORT "USER_BUTTON3_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;

# J13 SDRAM0 connector rows: SDRAM0_DQ0..DQ3.
# These are Bank 1 LVCMOS33 GPIOs, separate from the PMOD1 ADC pins.
# Only one selected row is driven low; unselected rows are high-Z.
IO_LOC  "ROW0" E14;
IO_PORT "ROW0" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC  "ROW1" E13;
IO_PORT "ROW1" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC  "ROW2" C15;
IO_PORT "ROW2" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC  "ROW3" C14;
IO_PORT "ROW3" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;

# J13 SDRAM0 connector columns: SDRAM0_DQ4..DQ11.
# The matrix PCB already supplies external 3.3 V pull-ups.
IO_LOC  "COL0" B13;
IO_PORT "COL0" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "COL1" C13;
IO_PORT "COL1" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "COL2" A14;
IO_PORT "COL2" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "COL3" A13;
IO_PORT "COL3" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "COL4" B21;
IO_PORT "COL4" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "COL5" A21;
IO_PORT "COL5" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "COL6" B20;
IO_PORT "COL6" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "COL7" A20;
IO_PORT "COL7" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

# NEO Dock PT8211 and amplifier shutdown
IO_LOC  "dac_bclk" Y17;
IO_PORT "dac_bclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "dac_lrck" AB17;
IO_PORT "dac_lrck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "dac_din" AA16;
IO_PORT "dac_din" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "pa_en_n" AB16;
IO_PORT "pa_en_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

# MCP3208 and four effect status LEDs: preserve the board-verified test3 pins.
IO_LOC  "adc_cs_n" AA20;
IO_PORT "adc_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "adc_sclk" AA21;
IO_PORT "adc_sclk" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC  "adc_mosi" AA19;
IO_PORT "adc_mosi" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC  "adc_miso" AB20;
IO_PORT "adc_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

IO_LOC  "event_led[0]" P16;
IO_PORT "event_led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "event_led[1]" R17;
IO_PORT "event_led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "event_led[2]" R18;
IO_PORT "event_led[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "event_led[3]" T18;
IO_PORT "event_led[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

# Additional 50 MHz oscillator and verified J5 RGB666 interface.
IO_LOC "sys_clk_50m" V22;
IO_PORT "sys_clk_50m" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "lcd_r[0]" G18;
IO_LOC "lcd_r[1]" G17;
IO_LOC "lcd_r[2]" H22;
IO_LOC "lcd_r[3]" J22;
IO_LOC "lcd_r[4]" K22;
IO_LOC "lcd_r[5]" K21;
IO_LOC "lcd_g[0]" K18;
IO_LOC "lcd_g[1]" L21;
IO_LOC "lcd_g[2]" M21;
IO_LOC "lcd_g[3]" M22;
IO_LOC "lcd_g[4]" N22;
IO_LOC "lcd_g[5]" L18;
IO_LOC "lcd_b[0]" M18;
IO_LOC "lcd_b[1]" N19;
IO_LOC "lcd_b[2]" N18;
IO_LOC "lcd_b[3]" K16;
IO_LOC "lcd_b[4]" L16;
IO_LOC "lcd_b[5]" M20;
IO_LOC "lcd_pclk" L19;
IO_LOC "lcd_hsync" N20;
IO_LOC "lcd_vsync" L15;
IO_LOC "lcd_de" L14;
IO_LOC "lcd_backlight" P20;
IO_PORT "lcd_r[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_r[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_r[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_r[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_r[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_r[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_g[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_g[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_g[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_g[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_g[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_g[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_b[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_b[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_b[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_b[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_b[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_b[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_pclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_hsync" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_vsync" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_de" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "lcd_backlight" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;

# Additional standard I2S on unused PMOD0 GPIO; CPU-as-GPIO must be enabled.
IO_LOC "i2s_bclk" P19;
IO_PORT "i2s_bclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "i2s_ws" R19;
IO_PORT "i2s_ws" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "i2s_data" T21;
IO_PORT "i2s_data" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;

// Native J6 touch connector; user confirmed the IO voltage is compatible.
IO_LOC "ctp_rst_n" T15;
IO_PORT "ctp_rst_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC "ctp_int" T16;
IO_PORT "ctp_int" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "ctp_sda" U16;
IO_PORT "ctp_sda" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
IO_LOC "ctp_scl" W16;
IO_PORT "ctp_scl" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;

# JDY-23 dedicated UART: J8-9 / PMOD1_IO2 TX, J8-10 / PMOD1_IO3 RX.
# 31005 J2-9 -> 60K AB21; J2-7 -> AB22. 9600 8N1, independent of BL616.
IO_LOC "song_uart_tx" AB21;
IO_PORT "song_uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "song_uart_rx" AB22;
IO_PORT "song_uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;

# Independent DEBUG-USB2 / BL616 UART, 115200 8N1. JDY-23 stays on J8.
IO_LOC "usb_song_uart_tx" U15;
IO_PORT "usb_song_uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "usb_song_uart_rx" V14;
IO_PORT "usb_song_uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=3.3;

# MPU-6050 independent open-drain GPIO bus. 31005 J8, unused by J8-5..8 ADC.
# J8-11 PMOD1_IO0 -> J2-5 -> Y21; J8-12 PMOD1_IO1 -> J2-3 -> Y22, Bank8 3V3.
IO_LOC "imu_scl" Y21;
IO_PORT "imu_scl" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "imu_sda" Y22;
IO_PORT "imu_sda" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 BANK_VCCIO=3.3;
