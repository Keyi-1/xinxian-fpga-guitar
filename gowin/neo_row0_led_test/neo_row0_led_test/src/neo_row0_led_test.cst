# 50 MHz 板载时钟
IO_LOC  "sys_clk_50m" V22;
IO_PORT "sys_clk_50m" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

# KEY0 / S4 / USER_BUTTON0
IO_LOC  "rst_n" AA13;
IO_PORT "rst_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;

# PMOD1：COL0～COL7
IO_LOC  "COL0" Y21;
IO_PORT "COL0" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

IO_LOC  "COL1" Y22;
IO_PORT "COL1" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

IO_LOC  "COL2" AB21;
IO_PORT "COL2" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

IO_LOC  "COL3" AB22;
IO_PORT "COL3" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

IO_LOC  "COL4" AA20;
IO_PORT "COL4" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

IO_LOC  "COL5" AA21;
IO_PORT "COL5" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

IO_LOC  "COL6" AA19;
IO_PORT "COL6" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

IO_LOC  "COL7" AB20;
IO_PORT "COL7" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

# PMOD0：LED0～LED7
IO_LOC  "LED0" P19;
IO_PORT "LED0" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;

IO_LOC  "LED1" R19;
IO_PORT "LED1" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;

IO_LOC  "LED2" T21;
IO_PORT "LED2" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;

IO_LOC  "LED3" U21;
IO_PORT "LED3" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;

IO_LOC  "LED4" P16;
IO_PORT "LED4" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;

IO_LOC  "LED5" R17;
IO_PORT "LED5" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;

IO_LOC  "LED6" R18;
IO_PORT "LED6" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;

IO_LOC  "LED7" T18;
IO_PORT "LED7" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;