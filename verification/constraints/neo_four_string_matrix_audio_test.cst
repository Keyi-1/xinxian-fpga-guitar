# NEO Dock 31005: MS5351M CLK2 configured for 12.288 MHz
IO_LOC  "audio_clk_12m288" V13;
IO_PORT "audio_clk_12m288" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

# KEY0 / S4: active-low RTL reset
IO_LOC  "rst_n" AA13;
IO_PORT "rst_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;

# J14 SDRAM1 connector rows.  These are the PMOD0_IO4..7 aliases and avoid
# the CPU dual-purpose P19/R19/T21/U21 pins used by PMOD0_IO0..3.
IO_LOC  "ROW0" P16;
IO_PORT "ROW0" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC  "ROW1" R17;
IO_PORT "ROW1" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC  "ROW2" R18;
IO_PORT "ROW2" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC  "ROW3" T18;
IO_PORT "ROW3" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;

# J14 SDRAM1 connector columns, electrically shared with PMOD1_IO0..7.
# The matrix PCB already supplies external 3.3 V pull-ups.
IO_LOC  "COL0" Y21;
IO_PORT "COL0" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "COL1" Y22;
IO_PORT "COL1" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "COL2" AB21;
IO_PORT "COL2" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "COL3" AB22;
IO_PORT "COL3" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "COL4" AA20;
IO_PORT "COL4" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "COL5" AA21;
IO_PORT "COL5" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "COL6" AA19;
IO_PORT "COL6" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "COL7" AB20;
IO_PORT "COL7" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

# NEO Dock PT8211 and amplifier shutdown
IO_LOC  "dac_bclk" Y17;
IO_PORT "dac_bclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "dac_lrck" AB17;
IO_PORT "dac_lrck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "dac_din" AA16;
IO_PORT "dac_din" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "pa_en_n" AB16;
IO_PORT "pa_en_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
