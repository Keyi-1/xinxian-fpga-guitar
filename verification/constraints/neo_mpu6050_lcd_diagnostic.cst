# Minimal LCD/MPU test: same physical pins and IO voltages as production.
IO_LOC  "pa_en_n" AB16;
IO_PORT "pa_en_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "sys_clk_50m" V22;
